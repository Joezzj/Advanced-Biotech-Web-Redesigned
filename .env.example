# Copy to .env at the project root, outside docs/. Never commit .env.
# Leave SMTP values empty for safe email-draft mode.
HOST=127.0.0.1
PORT=8000
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=info@advancedbiotech.co.nz
# If an HTTPS static frontend uses this API on a different origin,
# list its exact origins, comma-separated. Do not use a wildcard.
ALLOWED_ORIGINS=
